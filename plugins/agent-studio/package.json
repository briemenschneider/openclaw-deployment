      "minGatewayVersion": "2026.7.1"
    }
  },
  "dependencies": {
    "lit": "^3.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^18.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }

# Copy to .env and fill in. .env is gitignored — never commit it.

# Real API key from console.anthropic.com.
# Claude subscription quota does NOT work for third-party tools.
ANTHROPIC_API_KEY=

# Ollama has no real auth, but the field must be a non-empty string.
OLLAMA_API_KEY=ollama-local

# Gateway auth token. gateway.auth.token in openclaw.json is a SecretRef pointing
# at this variable, and docker-compose.yml requires it (${...:?}) - the stack will
# not start without it. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
